{
  "id": "bloomberg-paywall-remover",
  "name": "彭博去付费墙",
  "version": "1.0.14",
  "description": "隐藏 Bloomberg 文章页的付费墙遮罩、订阅弹层、渐变层与滚动锁；并内置阅读模式，把正文放入顶层阅读器，绕开延迟加载的黑色遮罩。",
  "author": "MeoBrowser",
  "sourceURL": "bundle://bloomberg-paywall-remover",
  "enabled": true,
  "matches": [
    "*://www.bloomberg.com/*",
    "*://bloomberg.com/*"
  ],
  "excludes": [],
